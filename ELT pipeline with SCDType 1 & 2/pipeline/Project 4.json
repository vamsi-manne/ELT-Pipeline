{
    "name": "Project 4",
    "properties": {
        "activities": [
            {
                "name": "Lookup_Tables",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "AzureSqlTableIncCopy",
                        "type": "DatasetReference",
                        "parameters": {
                            "TableName": "MetadataTable",
                            "SchemaName": "dbo"
                        }
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "ForEach",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Lookup_Tables",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_Tables').output.value",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "Copy data",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "select * from @{item().SchemaName}.@{item().TableName} where @{item().IncColumnName} > '@{item().LastLoadedValue}'",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "sink": {
                                    "type": "DelimitedTextSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextWriteSettings",
                                        "quoteAllText": true,
                                        "fileExtension": ".txt"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "AzureSqlTableIncCopy",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "TableName": "\"\"",
                                        "SchemaName": "\"\""
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "INC_COPY",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "FolderPath": {
                                            "value": "@item().FolderPath",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        },
                        {
                            "name": "LookUp_Max_Value",
                            "type": "Lookup",
                            "dependsOn": [
                                {
                                    "activity": "Copy data",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "select max(@{item().IncColumnName}) as max_value from @{item().SchemaName}.@{item().TableName}",
                                        "type": "Expression"
                                    },
                                    "queryTimeout": "02:00:00",
                                    "partitionOption": "None"
                                },
                                "dataset": {
                                    "referenceName": "AzureSqlTableIncCopy",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "TableName": "\"\"",
                                        "SchemaName": "\"\""
                                    }
                                }
                            }
                        },
                        {
                            "name": "Stored procedure",
                            "type": "SqlServerStoredProcedure",
                            "dependsOn": [
                                {
                                    "activity": "LookUp_Max_Value",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "storedProcedureName": "[dbo].[update_Customer_LLV]",
                                "storedProcedureParameters": {
                                    "IncColumnName": {
                                        "value": {
                                            "value": "@item().IncColumnName",
                                            "type": "Expression"
                                        },
                                        "type": "String"
                                    },
                                    "LastLoadedValue": {
                                        "value": {
                                            "value": "@activity('LookUp_Max_Value').output.firstRow.max_value",
                                            "type": "Expression"
                                        },
                                        "type": "DateTime"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "AzureSqlDatabase1",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "Data flow_Clean_Staging",
                            "type": "ExecuteDataFlow",
                            "dependsOn": [
                                {
                                    "activity": "Copy data",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataflow": {
                                    "referenceName": "Inc_Dataflow_Clean_Transform",
                                    "type": "DataFlowReference",
                                    "datasetParameters": {
                                        "source1": {
                                            "FolderName": {
                                                "value": "@item().FolderPath",
                                                "type": "Expression"
                                            },
                                            "FileName": {
                                                "value": "data_@{formatDateTime(utcNow(), 'yyyyMMdd')}.csv",
                                                "type": "Expression"
                                            }
                                        }
                                    }
                                },
                                "compute": {
                                    "coreCount": 8,
                                    "computeType": "General"
                                },
                                "traceLevel": "Fine"
                            }
                        },
                        {
                            "name": "DataFlow_SCDType 1",
                            "type": "ExecuteDataFlow",
                            "dependsOn": [
                                {
                                    "activity": "Data flow_Clean_Staging",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "dataflow": {
                                    "referenceName": "Inc_Dataflow_SCDType1",
                                    "type": "DataFlowReference"
                                },
                                "compute": {
                                    "coreCount": 8,
                                    "computeType": "General"
                                },
                                "traceLevel": "Fine"
                            }
                        }
                    ]
                }
            }
        ],
        "annotations": [],
